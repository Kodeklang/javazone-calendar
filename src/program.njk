---
pagination:
  data: site.talks
  size: 1
  alias: session
permalink: "{{ session.url }}"
layout: base.njk
---
<div class="app app--detail">
  {% include "masthead.njk" %}

  <main class="detail">
    <header class="detail__head">
      <p class="detail__meta">
        <span class="chip chip--solid" style="--track: {{ session.colour }}"
              data-en="{{ session.formatName.en }}">{{ session.formatName.no }}</span>
        <span class="detail__day" data-en="{{ session.day.longLabel.en }}">{{ session.day.longLabel.no }}</span>
        <span class="countdown" id="countdown"
              data-start="{{ session.startUtc }}" data-end="{{ session.endUtc }}"></span>
      </p>

      {#- The mark sits with the title rather than in the masthead: it belongs
          to this session, not to the app around it. Hidden until app.js
          reveals it, the same contract #copy-link uses below - with no script
          there is nowhere to remember the mark, and a check that forgets is
          worse than none.

          aria-pressed carries the state, so the label stays put instead of
          flipping between "mark" and "unmark"; the name is a nested span
          because that is the only part applyLang() can rewrite. #}
      <div class="detail__title">
        <h1>{{ session.title }}</h1>
        <button type="button" class="pick" id="pick" data-session="{{ session.id }}"
                aria-pressed="false" hidden>
          {%- set checkClass = "pick__check" %}
          {% include "check.njk" %}
          <span class="visually-hidden" data-en="Mark as one to see"
                data-no="Merk som en du vil se">Merk som en du vil se</span>
        </button>
      </div>

      <p class="pills">
        <span class="pill pill--time">
          <time datetime="{{ session.startUtc }}">{{ session.startUtc | time }}</time>–<time datetime="{{ session.endUtc }}">{{ session.endUtc | time }}</time>
        </span>
        <span class="pill">{{ session.roomName }}</span>
      </p>

      <p class="tags">
        {%- if session.languageName %}
        <span class="tag" data-en="{{ session.languageName.en }}">{{ session.languageName.no }}</span>
        {%- endif %}
        <span class="tag" data-en="{{ session.durationMin | durationEn }}">{{ session.durationMin | duration }}</span>
        {%- for k in session.keywords %}
        <span class="tag tag--keyword">{{ k }}</span>
        {%- endfor %}
      </p>

      {#- Two quiet controls under the tags, as the design has them, plus a
          third when there is a recording. The data-en spans are nested
          rather than sitting on the anchor itself because applyLang()
          assigns textContent, which on the anchor would take the arrow with
          it. data-no is spelled out so that same first touch cannot latch
          onto a transient "Kopiert".

          Like the speaker links below, the new tab is signalled visually and
          not announced - the arrow is decorative and there is no spoken
          warning, which is the call this template already made. #}
      <p class="linkrow">
        <a class="linkrow__item" href="{{ session.officialUrl }}"
           rel="noopener noreferrer" target="_blank">
          <span data-en="View on javazone.no" data-no="Se på javazone.no">Se på javazone.no</span>
          <span class="linkrow__ext" aria-hidden="true">↗</span>
        </a>
        {#- Moved up from the "Opptak" section below, which now holds the
            player itself; the wording stays exactly what it was there so a
            reader who has seen it before still recognises it. #}
        {%- if session.video %}
        <a class="linkrow__item" href="https://vimeo.com/{{ session.video }}"
           rel="noopener noreferrer" target="_blank">
          <span data-en="Watch on Vimeo" data-no="Se opptaket på Vimeo">Se opptaket på Vimeo</span>
          <span class="linkrow__ext" aria-hidden="true">↗</span>
        </a>
        {%- endif %}
        {#- Hidden until app.js reveals it: with no clipboard there is nothing
            for it to do, and a button that does nothing is worse than none. #}
        <button type="button" class="linkrow__item" id="copy-link" hidden>
          <span id="copy-label" data-en="Copy link" data-no="Kopier lenke">Kopier lenke</span>
        </button>
      </p>
      <p class="visually-hidden" id="copy-status" role="status" aria-live="polite"></p>
    </header>

    {%- if session.speakers.length %}
    <section class="detail__section">
      <h2 class="section__label" data-en="{{ 'Speakers' if session.speakers.length > 1 else 'Speaker' }}">
        {{ 'Foredragsholdere' if session.speakers.length > 1 else 'Foredragsholder' }}
      </h2>
      {%- for p in session.speakers %}
      <article class="speaker">
        <div class="speaker__head">
          {#- Sleeping Pill publishes no speaker photos, so the few that exist
              are fetched from the speakers' own Bluesky accounts - see
              scripts/fetch-photos.mjs. Most speakers have none and keep the
              monogram, which is drawn to the same 60px circle, so a card with
              a photo and one without sit on identical bounds.

              alt is empty on purpose: the name is in the h3 alongside, so
              anything here would only be read out twice. #}
          {%- if p.photo %}
          <img class="speaker__photo" src="{{ p.photo.url | url }}?v={{ site.buildId }}"
               width="{{ p.photo.width }}" height="{{ p.photo.height }}"
               alt="" loading="lazy" decoding="async">
          {%- else %}
          <span class="speaker__mono" style="--track: {{ session.colour }}" aria-hidden="true">{{ p.initials }}</span>
          {%- endif %}
          <div class="speaker__who">
            <h3 class="speaker__name">{{ p.name }}</h3>
            {%- if p.links.linkedin or p.links.bluesky or p.links.twitter %}
            <p class="speaker__links">
              {%- if p.links.linkedin %}
              <a href="{{ p.links.linkedin }}" rel="noopener noreferrer" target="_blank">LinkedIn</a>
              {%- endif %}
              {%- if p.links.bluesky %}
              <a href="https://bsky.app/profile/{{ p.links.bluesky }}" rel="noopener noreferrer" target="_blank">Bluesky</a>
              {%- endif %}
              {%- if p.links.twitter %}
              <a href="https://x.com/{{ p.links.twitter }}" rel="noopener noreferrer" target="_blank">X</a>
              {%- endif %}
            </p>
            {%- endif %}
          </div>
        </div>
        {%- for para in p.bio %}
        <p class="speaker__bio">{{ para | safe }}</p>
        {%- endfor %}
      </article>
      {%- endfor %}
    </section>
    {%- endif %}

    {%- if session.description.length %}
    <section class="detail__section">
      <h2 class="section__label" data-en="About this session">Om sesjonen</h2>
      {%- for para in session.description %}
      <p class="detail__body">{{ para | safe }}</p>
      {%- endfor %}
    </section>
    {%- endif %}

    {%- if session.audience %}
    <section class="detail__section">
      <h2 class="section__label" data-en="Who it is for">Passer for</h2>
      <p class="detail__body">{{ session.audience }}</p>
    </section>
    {%- endif %}

    {%- if session.prerequisites %}
    <section class="detail__section">
      <h2 class="section__label" data-en="Before you arrive">Forberedelser</h2>
      {#- Setup instructions: numbered steps, shell commands, sometimes fenced
          code. Reflowing them would destroy them, so the line breaks stand. #}
      <p class="detail__pre">{{ session.prerequisites | safe }}</p>
    </section>
    {%- endif %}

    {%- if session.video %}
    <section class="detail__section">
      <h2 class="section__label" data-en="Recording">Opptak</h2>
      {#- Vimeo's copy-paste snippet also ships a padding-top wrapper to hold
          the 16:9 box and a <script src=".../player.js"> line; neither is
          here. The box is aspect-ratio in the stylesheet instead, keeping
          layout out of the markup the way every other rule on this page
          does; the script exists only to drive the Player API, which
          nothing on this page calls, and the page already ships its own.
          loading="lazy" because the section sits below the fold and the
          player is heavy - title names the session so a screen reader
          hears what the frame holds rather than "iframe". #}
      <iframe class="detail__video" src="https://player.vimeo.com/video/{{ session.video }}"
              title="Opptak av {{ session.title }}"
              allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
              allowfullscreen loading="lazy"></iframe>
    </section>
    {%- endif %}

    {%- if session.parallel.length %}
    <section class="detail__section">
      <h2 class="section__label" data-en="On at the same time">Samtidig i programmet</h2>
      <ol class="parallel">
        {%- for p in session.parallel %}
        <li class="parallel__item" style="--track: {{ p.colour }}">
          <a href="{{ p.url | url }}">
            <time class="parallel__time" datetime="{{ p.startUtc }}">{{ p.startUtc | time }}</time>
            <span class="parallel__title">{{ p.title }}</span>
            <span class="parallel__room">{{ p.roomName }}</span>
          </a>
        </li>
        {%- endfor %}
      </ol>
    </section>
    {%- endif %}
  </main>
</div>
